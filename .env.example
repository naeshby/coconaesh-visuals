# ──────────────────────────────────────────────
# CocoNaesh Visuals: environment template
# Copy to .env and adjust. NEVER commit .env.
# These are DEVELOPMENT values only.
# ──────────────────────────────────────────────

NODE_ENV=development

# ── PostgreSQL (used by docker-compose.yml) ──
POSTGRES_USER=coconaesh
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=coconaesh_dev
POSTGRES_PORT=5432

# ── Prisma / API database connection ──
# Must match the three values above.
DATABASE_URL=postgresql://coconaesh:change_me_dev_only@localhost:5432/coconaesh_dev?schema=public

# ── API ──
API_HOST=0.0.0.0
API_PORT=3000
# Origin allowed by CORS (the frontend)
WEB_ORIGIN=http://localhost:5173

# ── Frontend (exposed to the browser: no secrets here) ──
VITE_API_BASE_URL=http://localhost:3000

# ── Local storage root (development) ──
STORAGE_ROOT=./storage